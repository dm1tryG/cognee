{
  "name": "n8n-nodes-cognee",
  "version": "0.1.0",
  "description": "n8n community node for Cognee AI memory engine",
  "keywords": [
    "n8n-community-node-package",
    "n8n-nodes",
    "cognee",
    "ai",
    "memory",
    "knowledge-graph"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cognee-dev/n8n-nodes-cognee",
  "author": {
    "name": "Cognee Team",
    "email": "info@cognee.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cognee-dev/n8n-nodes-cognee.git"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=9.1"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CogneeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Cognee/Cognee.node.js",
      "dist/nodes/CogneeDeclarative/CogneeDeclarative.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.40.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
